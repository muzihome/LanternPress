# 文本类源码文件，仓库强制使用 LF 换行
*.php text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.htm text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.conf text eol=lf
*.ini text eol=lf
*.sh text eol=lf

# Windows批处理脚本使用CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件，禁止换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.svg binary
*.zip binary
*.7z binary
*.rar binary
*.gz binary
*.tar binary
*.pdf binary
*.db binary

