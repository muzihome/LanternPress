# ===================== Windows系统文件 =====================
Thumbs.db
ehthumbs.db
Desktop.ini
*.tmp
*.swp
*.bak

# ===================== IDE 编辑器 =====================
# VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains PHPStorm / IDEA
.idea/
*.iml
*.iws
*.local

# Sublime
*.sublime-project
*.sublime-workspace

# ===================== PHP / Composer =====================
/vendor/
composer.lock
!composer.lock

# 本地环境配置、密钥（重要，防止泄露数据库、密钥）
.env
.env.local
.env.*.local
config.local.php
dbconfig.local.php

# ===================== PHP 缓存、日志、编译缓存 =====================
*.log
logs/
runtime/
cache/
temp/
tmp/
upload/cache/
storage/cache/
*.php~

# ===================== Typecho 项目特有 =====================
# 上传附件（用户上传图片资源，不提交版本库）
usr/uploads/
usr/cache/
# 数据库备份导出文件
*.sql
*.sql.gz
*.dump

# ===================== Node / NPM （如有前端编译） =====================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dist/
build/

# ===================== Git 自身临时文件 =====================
*.orig
.rej

# ===================== 本地开发备份 =====================
_backup/
_backups/
*.zip
*.rar
*.7z

