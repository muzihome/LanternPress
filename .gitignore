# ============================================================
# LanternPress Typecho 主题 - Git 忽略规则
# ============================================================

# --- 构建与工作目录 ---
.trae/
.idea/
.vscode/
*.swp
*.swo

# --- 运行时缓存（Typecho 自动生成 + 主题文件缓存）---
# 所有缓存统一落在主题根 cache/ 目录，deploy-sync 同步时整体跳过（仅 .htaccess 保留）
#   content/{cid}.php    正文处理结果（按文章 ID 命名）
#   rate_limit_*.php     点赞/视图限流计数
#   archive-cache.php    归档页查询缓存
#   sidebar-cache.php    侧边栏热门/站点信息缓存
cache/*
!cache/.htaccess

# --- 压缩产物（deploy-sync 自动生成，源码只保留格式化版）---
assets/css/*.min.css
assets/css/*.min.css.map
assets/js/*.min.js
assets/js/*.min.js.map

# --- 操作系统垃圾文件 ---
.DS_Store
Thumbs.db
desktop.ini

# --- 编辑器/临时文件 ---
*.log
*.tmp
*.bak
*~

# --- 批次文档/截图（误提交防护）---
batch-*/

